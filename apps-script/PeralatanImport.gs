function importPeralatanData() {
  const existing = {};
  readSheet_('Peralatan').forEach(function (r) { existing[importKey_(r)] = true; });

  let added = 0;
  let skipped = 0;
  PERALATAN_IMPORT.forEach(function (r) {
    const key = importKey_(r);
    if (existing[key]) { skipped++; return; }
    createRecord_('Peralatan', r);
    existing[key] = true;
    added++;
  });

  Logger.log('Peralatan: ' + added + ' ditambah, ' + skipped + ' dilangkau');
  return { added: added, skipped: skipped };
}

function importKey_(r) {
  const serial = String(r.noSiri || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  const kod = String(r.kodSekolah || '').toUpperCase();
  if (serial) return kod + '|' + serial;
  return kod + '|' + String(r.model || '').toUpperCase() + '|' + String(r.catatan || '').toUpperCase();
}