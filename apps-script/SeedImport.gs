function importSeedData() {
  const peralatan = importSeedSheet_('Peralatan', SEED_PERALATAN, function (r) {
    return [r.kodSekolah, r.fasa, r.jenisPeralatan, r.noSiri, r.lokasi, r.catatan].join('|');
  });
  const kontrak = importSeedSheet_('Kontrak', SEED_KONTRAK, function (r) {
    return [r.fasa, r.vendor, r.scope].join('|');
  });
  Logger.log('Peralatan: ' + peralatan.added + ' ditambah, ' + peralatan.skipped + ' dilangkau');
  Logger.log('Kontrak: ' + kontrak.added + ' ditambah, ' + kontrak.skipped + ' dilangkau');
}

function importSeedSheet_(name, rows, keyOf) {
  const existing = {};
  readSheet_(name).forEach(function (r) { existing[keyOf(r)] = true; });
  let added = 0;
  let skipped = 0;
  rows.forEach(function (r) {
    const key = keyOf(r);
    if (existing[key]) {
      skipped++;
      return;
    }
    createRecord_(name, r);
    existing[key] = true;
    added++;
  });
  return { added: added, skipped: skipped };
}
